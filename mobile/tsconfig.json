{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    // The pure test suite runs through Node's `--experimental-strip-types`,
    // which requires explicit `.ts` extensions on relative imports. This is
    // type-check only (noEmit is inherited from expo/tsconfig.base), so no
    // output is affected.
    "allowImportingTsExtensions": true,
    // The `lib/local-first/__tests__` suites are Node scripts (`node:test`,
    // `node:sqlite`), so they need Node's ambient types. Without this they were
    // excluded from automatic @types discovery and every `node:*` import failed
    // to resolve. Type-check only (noEmit), so there is no runtime effect.
    "types": ["node"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
